# Copia este archivo a .env y ajusta los valores si hace falta.
# .env NO se sube al repo (ver .gitignore); estos son solo los valores
# por defecto con los que se levanta el Mongo de docker-compose.

MONGO_USER=admin
MONGO_PASSWORD=admin123
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=SubvencionesBOCYL
